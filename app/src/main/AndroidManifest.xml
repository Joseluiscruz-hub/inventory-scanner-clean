<?xml version="1.0" encoding="utf-8"?>
<manifest
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Exportacion usa SAF/FileProvider, no permisos legacy de storage -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Features -->
    <uses-feature
            android:name="android.hardware.camera"
            android:required="true"/>
    <uses-feature
            android:name="android.hardware.camera.autofocus"
            android:required="false"/>

    <application
            android:name=".InventoryScannerApp"
            android:allowBackup="false"
            android:fullBackupContent="false"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:usesCleartextTraffic="false"
            android:networkSecurityConfig="@xml/network_security_config"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/PremiumTheme"
            tools:targetApi="31">

        <!-- Actividad de Splash Screen con video -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.splash.SplashActivity"
                android:exported="true"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Actividad de Login -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.login.LoginActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"/>

        <!-- Nueva actividad principal basada en Compose -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"/>


        <!-- Actividad de Dashboard -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.dashboard.DashboardComposeActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Actividades de inventario -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.inventario.screen.InventarioComposeActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Actividad de navegación con Shared Transition para lista de materiales -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.inventario.screen.InventarioNavHostActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.AjusteInventarioActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Nueva actividad de Resumen en Compose -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.inventario.screen.InventarioResumenComposeActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>


        <activity
                android:name="com.joseluiscruz.capturainventario.ui.inventario.screen.CatalogoPlantaActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>


        <activity
                android:name="com.joseluiscruz.capturainventario.RestosActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>


        <!-- Actividades recién creadas -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.importar.ImportarActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.ui.config.ConfiguracionActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.ui.almacenes.GestionAlmacenesActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.ui.opciones.MasOpcionesActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.ui.opciones.HelpActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.opciones.MasOpcionesActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.ui.opciones.FeedbackActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.opciones.MasOpcionesActivity"/>

        <activity
                android:name="com.joseluiscruz.capturainventario.ui.comparacion.ComparacionTiempoRealActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Actividad de Exportar -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.exportar.ExportarActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Actividad de Dashboard Comparación -->
        <activity
                android:name="com.joseluiscruz.capturainventario.dashboard.DashboardComparacionActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Actividad de Gestión de Reinicio -->
        <activity
                android:name="com.joseluiscruz.capturainventario.ui.reinicio.GestionReinicioActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Actividad de Traspasos de Almacén -->
        <activity
                android:name="com.joseluiscruz.capturainventario.TraspasoActivity"
                android:label="Traspasos"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/PremiumTheme.NoActionBar"
                android:parentActivityName="com.joseluiscruz.capturainventario.ui.main.MainComposeActivity"/>

        <!-- Provider para compartir archivos -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>

        <service
                android:name="com.joseluiscruz.capturainventario.ui.common.PremiumCalculatorService"
                android:enabled="true"
                android:exported="false"
                android:foregroundServiceType="specialUse">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="calculator_overlay"/>
        </service>

        <service
                android:name="com.joseluiscruz.capturainventario.service.BrandMessagingService"
                android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

    </application>

</manifest>
